# EODHD API key - https://eodhd.com/
EODHD_API_KEY=

# KDB-X DB Service gateway host:port
DB_SERVICE_HOST=localhost:8080

# Absolute path to db-service/data/imports on this machine
DB_SERVICE_IMPORTS_DIR=/absolute/path/to/Portfolio-Analytic-tool/db-service/data/imports

# Benchmark symbol in TICKER.EXCHANGE form, used for performance comparison
BENCHMARK_SYMBOL=GSPC.INDX

# Annual risk-free rate (decimal) used in Sharpe ratio calculation
RISK_FREE_RATE=0.0

# Logging. DEBUG adds per-symbol fetches and job status transitions.
LOG_LEVEL=INFO
# Defaults to <repo>/logs if unset
# LOG_DIR=
